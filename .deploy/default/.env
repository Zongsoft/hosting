#@import ../.env

# Complete scheme defaults. The selected environment-network file supplies connection settings.

[network]
server=127.0.0.1

[redis]
server=${network:server}
username=
password=xxxxxx

# SQL Server uses Server for the complete endpoint, including any instance or port.
[mssql]
server=${network:server}
username=sa
password=
database=zongsoft
integratedsecurity=false
trustservercertificate=false
timeout=30s

[mysql]
server=${network:server}
port=3306
username=program
password=xxxxxx
database=zongsoft
charset=utf8mb4
convertzerodatetime=true
allowzerodatetime=true
allowloadlocalinfile=true
allowpublickeyretrieval=true
sslmode=none

# Additional database examples; provide the credentials required by this scheme.
[postgres]
server=${network:server}
port=5432
username=postgres
password=
database=zongsoft
sslmode=Prefer
timeout=30s

# File paths are interpreted by the database provider at application runtime.
[sqlite]
database=zongsoft.db
mode=ReadWriteCreate
cache=Default
foreignkeys=true
timeout=30s

[duckdb]
database=zongsoft.duckdb

[clickhouse]
server=${network:server}
port=8123
username=program
password=xxxxxx
database=zongsoft
compression=True

[tdengine]
server=${network:server}
port=6041
username=program
password=xxxxxx
database=zongsoft
autoreconnect=true
enablecompression=true

# InfluxDB 3 uses a URL and token, not a database user/password pair.
[influx]
server=http://${network:server}:8181
database=zongsoft
token=
organization=
precision=ms
timeout=15s

# Empty credentials select an unauthenticated local etcd connection.
[etcd]
server=${network:server}
port=2379
username=
password=

# Local S3-compatible endpoint; reuse the RustFS credentials from hosting/.env.
# For AWS S3, leave server empty and provide the region and credentials for the scheme.
[amazon.s3]
server=http://${network:server}:9000
region=
accesskey=${rustfs:access_key}
secretkey=${rustfs:secret_key}
accountid=
client=zongsoft_${environment}
timeout=30s

[messaging.mqtt]
server=${network:server}
username=program
password=xxxxxx
group=G1
client=zongsoft_${environment}

# Local broker examples; configure addresses and credentials for this scheme.
[messaging.kafka]
server=${network:server}:9092
username=
password=
group=G1
client=zongsoft_${environment}
securityprotocol=Plaintext

[messaging.rabbitmq]
server=${network:server}
port=5672
username=guest
password=guest
container=/
group=G1
client=zongsoft_${environment}

[messaging.zeromq]
server=${network:server}
port=7969
control=32100
incoming=32101
outgoing=32102
group=G1
client=zongsoft_${environment}

[messaging.redis]
server=${network:server}
username=
password=xxxxxx
group=G1
client=zongsoft_${environment}
deadline=10000
idletimeout=30s

[aliyun]
region=Hangzhou
intranet=false
certificate=main
code=xxxxxxxxxx
secret=xxxxxxxxxx
bucket=zongsoft-files
message_template=SMS_100
message_scheme=Zongsoft
voice_numbers=073112345678
voice_template=TTS_100
app_name=TheFriendlyName
app_code=The App Key
app_secret=The App Secret
account=1234567890
queue=TheQueueName
topic=TheTopicName

[diagnostics.telemetry]
enabled=true
server=http://127.0.0.1:4317

[diagnostics.logging]
enabled=false
server=${diagnostics.telemetry:server}
protocol=grpc

[diagnostics.prometheus]
server=127.0.0.1
port=9465

# Select one environment-network combination after defining all defaults.
#@import ${environment}-${network}.env
