# Service connections for production / external.
# Keep common behavior settings in .env; define each service endpoint and credentials here.
# Redis, MQTT and Kafka ports belong in server; URL endpoints include their ports.

[network]
server=127.0.0.1

[redis]
server=${network:server}
username=
password=xxxxxx

# SQL Server uses the complete endpoint in server, including any instance or port.
[mssql]
server=${network:server}
username=sa
password=

[mysql]
server=${network:server}
port=3306
username=program
password=xxxxxx

[postgres]
server=${network:server}
port=5432
username=postgres
password=

[clickhouse]
server=${network:server}
port=8123
username=program
password=xxxxxx

# The default TDengine protocol is Native.
[tdengine]
server=${network:server}
port=6041
username=program
password=xxxxxx

[influx]
server=http://${network:server}:8181
token=

[etcd]
server=${network:server}
port=2379
username=
password=

[amazon.s3]
server=http://${network:server}:9000
accesskey=${rustfs:access_key}
secretkey=${rustfs:secret_key}
accountid=

[messaging.mqtt]
server=${network:server}
username=program
password=xxxxxx

[messaging.kafka]
server=${network:server}:9092
username=
password=

[messaging.rabbitmq]
server=${network:server}
port=5672
username=guest
password=guest

[messaging.zeromq]
server=${network:server}
port=7969
control=32100
incoming=32101
outgoing=32102

[messaging.redis]
server=${network:server}
username=
password=xxxxxx

[aliyun]
intranet=false
code=xxxxxxxxxx
secret=xxxxxxxxxx
app_code=The App Key
app_secret=The App Secret
account=10118642
