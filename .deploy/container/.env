# Reuse default settings and its selected <environment>-<network>.env.
# Container service names override endpoints after the import.
# Credentials, ports and external service endpoints remain inherited.
#@import ../default/.env

[redis]
server=redis

[mysql]
server=mysql

[amazon.s3]
server=http://rustfs:9000

[etcd]
server=etcd

[messaging.redis]
server=redis

[messaging.zeromq]
server=zongsoft.daemon

[diagnostics.prometheus]
server=0.0.0.0
