# Application connections use service names on the Containerizer network.
# Infrastructure credentials and other settings are inherited from the default scheme.
#@import ../default/.env

[redis]
server=redis

[mysql]
server=mysql

[amazon.s3]
server=http://rustfs:9000

[etcd]
server=etcd

[messaging.redis]
server=redis

[messaging.zeromq]
server=zongsoft.daemon
