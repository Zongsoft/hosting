#@import ../.env

# Shared deployment expressions. Imported explicitly by each scheme.

[redis]
connection=server=${redis:server};password=${redis:password}

[mssql]
connection=Server=${mssql:server};UserName=${mssql:username};Password=${mssql:password};Database=${mssql:database};IntegratedSecurity=${mssql:integratedsecurity};TrustServerCertificate=${mssql:trustservercertificate};Timeout=${mssql:timeout}

[mysql]
connection=Server=${mysql:server};UserName=${mysql:username};Password=${mysql:password};Database=${mysql:database};Charset=${mysql:charset};ConvertZeroDatetime=${mysql:convertzerodatetime};AllowZeroDateTime=${mysql:allowzerodatetime};AllowLoadLocalInfile=${mysql:allowloadlocalinfile};AllowPublicKeyRetrieval=${mysql:allowpublickeyretrieval};SslMode=${mysql:sslmode}

[postgres]
connection=Server=${postgres:server};Port=${postgres:port};UserName=${postgres:username};Password=${postgres:password};Database=${postgres:database};SslMode=${postgres:sslmode};Timeout=${postgres:timeout}

[sqlite]
connection=Database=${sqlite:database};Mode=${sqlite:mode};Cache=${sqlite:cache};ForeignKeys=${sqlite:foreignkeys};Timeout=${sqlite:timeout}

[duckdb]
connection=Database=${duckdb:database}

[clickhouse]
connection=Server=${clickhouse:server};UserName=${clickhouse:username};Password=${clickhouse:password};Database=${clickhouse:database};Compression=${clickhouse:compression}

[tdengine]
connection=Server=${tdengine:server};UserName=${tdengine:username};Password=${tdengine:password};Database=${tdengine:database};AutoReconnect=${tdengine:autoreconnect};EnableCompression=${tdengine:enablecompression}

[influx]
connection=Server=${influx:server};Database=${influx:database};Token=${influx:token};Organization=${influx:organization};Precision=${influx:precision};Timeout=${influx:timeout}

[etcd]
connection=Server=${etcd:server};Port=${etcd:port};UserName=${etcd:username};Password=${etcd:password}

[amazon.s3]
connection=Server=${amazon.s3:server};Region=${amazon.s3:region};AccessKey=${amazon.s3:accesskey};SecretKey=${amazon.s3:secretkey};AccountId=${amazon.s3:accountid};Client=${amazon.s3:client};Timeout=${amazon.s3:timeout}

[messaging.mqtt]
connection=server=${messaging.mqtt:server};username=${messaging.mqtt:username};password=${messaging.mqtt:password};group=${messaging.mqtt:group};client=${messaging.mqtt:client}

[messaging.kafka]
connection=server=${messaging.kafka:server};username=${messaging.kafka:username};password=${messaging.kafka:password};group=${messaging.kafka:group};client=${messaging.kafka:client};securityProtocol=${messaging.kafka:securityprotocol}

[messaging.rabbitmq]
connection=server=${messaging.rabbitmq:server};port=${messaging.rabbitmq:port};username=${messaging.rabbitmq:username};password=${messaging.rabbitmq:password};container=${messaging.rabbitmq:container};group=${messaging.rabbitmq:group};client=${messaging.rabbitmq:client}

[messaging.zeromq]
connection=server=${messaging.zeromq:server};port=${messaging.zeromq:port};group=${messaging.zeromq:group};client=${messaging.zeromq:client}

[messaging.redis]
connection=server=${messaging.redis:server};password=${messaging.redis:password};group=${messaging.redis:group};client=${messaging.redis:client};deadline=${messaging.redis:deadline};idleTimeout=${messaging.redis:idletimeout}
