<?xml version="1.0" encoding="utf-8" ?>

<!-- 配置示例：作为最终 Zongsoft.Diagnostics.option；指标与日志使用独立开关，日志默认关闭。 -->
<options>
	<option path="/Diagnostics">
		<diagnostor>
			<meters>
				<filter>*</filter>

				<exporters>
					<exporter exporter.name="telemetry" driver="opentelemetry"
					          enabled="${diagnostics.telemetry:enabled#xml}"
					          settings="server=${diagnostics.telemetry:server#xml};protocol=grpc;timeout=30s;interval=15s;" />
				</exporters>
			</meters>

			<logs includeScopes="true" includeFormattedMessage="true">
				<exporters>
					<exporter exporter.name="telemetry" driver="opentelemetry"
					          enabled="${diagnostics.logging:enabled#xml}"
					          settings="server=${diagnostics.logging:server#xml};protocol=${diagnostics.logging:protocol#xml};processorType=batch;timeout=30s;interval=5s;" />
				</exporters>
			</logs>
		</diagnostor>
	</option>
</options>
