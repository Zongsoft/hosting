<?xml version="1.0" encoding="utf-8" ?>

<?zongsoft.tools.binding name="zeromq/control"
	path="Messaging/ZeroMQ/Server"
	filter="enabled:true"
	template="\${this.control}"
	protocols="tcp"?>
<?zongsoft.tools.binding name="zeromq/incoming"
	path="Messaging/ZeroMQ/Server"
	filter="enabled:true"
	template="\${this.incoming}"
	protocols="tcp"?>
<?zongsoft.tools.binding name="zeromq/outgoing"
	path="Messaging/ZeroMQ/Server"
	filter="enabled:true"
	template="\${this.outgoing}"
	protocols="tcp"?>
<?zongsoft.tools.binding name="zeromq/discovery"
	path="Messaging/ZeroMQ/Server"
	filter="enabled:true"
	template="\${this.discovery}"
	protocols="tcp"?>

<options>
	<option path="/Externals/Redis">
		<connectionSettings>
			<connectionSetting connectionSetting.name="QueueServer" driver="Redis"
			                   value="${redis:connection#xml}" />
		</connectionSettings>
	</option>

	<option path="/Messaging/ZeroMQ">
		<server name="QueueServer" enabled="true"
		        storage="QueueServer"
		        control="tcp://0.0.0.0:${messaging.zeromq:control#xml}"
		        incoming="tcp://0.0.0.0:${messaging.zeromq:incoming#xml}"
		        outgoing="tcp://0.0.0.0:${messaging.zeromq:outgoing#xml}"
		        discovery="tcp://0.0.0.0:${messaging.zeromq:port#xml}" />
	</option>
</options>
