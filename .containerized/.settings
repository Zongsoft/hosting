# Infrastructure image tags selected on 2026-10-01.
# Shared defaults. Passwords reference the source `.env` file.
# OTel 0.162.0 currently has architecture-specific tags; this selection is for x64.

# Databases
[mysql]
tag=8.4.11
settings=storage=persistent;root-password=$(mysql_root_password)

[mariadb]
tag=13.0.2
settings=storage=persistent

[postgresql]
tag=18.6
settings=storage=persistent

[sqlserver]
tag=2025-CU9-ubuntu-22.04
settings=storage=persistent

[mongodb]
tag=9.0.2
settings=storage=persistent

[clickhouse]
tag=26.9.10.4
settings=storage=persistent

[tdengine]
tag=3.4.2.2
settings=storage=persistent

[influxdb]
tag=3.12.0-core
settings=storage=persistent


# Caches
[redis]
tag=8.10.2
settings=storage=persistent;persistence=both;password=$(redis_password)

[valkey]
tag=9.1.2
settings=storage=persistent;persistence=both

[memcached]
tag=1.6.45-alpine


# Messaging services
[emqx]
tag=6.3.1
settings=storage=persistent

[kafka]
tag=4.3.1
settings=storage=persistent

[rabbitmq]
tag=4.3.6-management
settings=storage=persistent

[nats]
tag=2.15.0-alpine
settings=storage=persistent

[mosquitto]
tag=2.1.2-alpine
settings=storage=persistent


# Service discovery, configuration and coordination
[etcd]
tag=v3.7.2
settings=storage=persistent

[consul]
tag=2.0.4
settings=storage=persistent

[nacos]
tag=v3.2.4
settings=storage=persistent

[zookeeper]
tag=3.9.5
settings=storage=persistent


# Object storage
[rustfs]
tag=1.0.1
settings=storage=persistent;access-key=$(rustfs_access_key);secret-key=$(rustfs_secret_key)


# Web and reverse proxies
[nginx]
tag=1.30.5

[caddy]
tag=2.11.6
settings=storage=persistent

[haproxy]
tag=3.4.6


# Search engines
[opensearch]
tag=3.9.0
settings=storage=persistent

[elasticsearch]
tag=9.5.4
settings=storage=persistent


# Monitoring, logging and tracing
[prometheus]
tag=v3.15.0-busybox
settings=storage=persistent

[grafana]
tag=13.2.3
settings=storage=persistent

[loki]
tag=3.7.8
settings=storage=persistent

[otel]
tag=0.162.0-amd64

