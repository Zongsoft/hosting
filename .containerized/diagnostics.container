# Metrics infrastructure only. Add these component sections to an application manifest as needed.
name=zongsoft-diagnostics
version=1.0
distribution=debian@13
architecture=x64
source=..
output=.containerized

[otel]
tag=0.162.0-amd64
template=.containerized/templates/otel.template

[prometheus]
tag=v3.15.0-busybox
template=.containerized/templates/prometheus.template
settings=storage=persistent
