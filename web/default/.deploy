../../mime
../../.deploy/${scheme}/${host}.deploy
../../.deploy/${scheme}/${site}.deploy

template:../../.deploy/.shared/app.option.template = Zongsoft.Hosting.Web.option
template:../../.deploy/.shared/web.option.template = web.option

#@import ../web.deploy

[plugins]
bin/${edition}/${framework}/plugins/Main.plugin

[plugins zongsoft diagnostics]
template:../../.deploy/.shared/Zongsoft.Diagnostics.option.template

[plugins zongsoft externals aliyun]
template:../../.deploy/.shared/Zongsoft.Externals.Aliyun.option.template

[plugins zongsoft messaging zeromq]
template:../../.deploy/.shared/Zongsoft.Messaging.ZeroMQ.option.template
