<?xml version="1.0" encoding="utf-8" ?>

<configuration>
	<option path="/Data">
		<connectionSettings default="Zongsoft">
			<connectionSetting connectionSetting.name="Zongsoft" driver="MySql"
			                   value="Server=127.0.0.1;Port=3306;UserName=program;Password=xxxxxx;Database=zongsoft;Charset=utf8mb4;ConvertZeroDatetime=true;AllowZeroDateTime=true;AllowLoadLocalInfile=true;AllowPublicKeyRetrieval=true;SslMode=none" />

			<connectionSetting connectionSetting.name="Zongsoft.PostgreSql" driver="PostgreSql"
			                   value="Server=127.0.0.1;Port=5432;UserName=postgres;Password=;Database=zongsoft;SslMode=Prefer;Timeout=30s" />

			<connectionSetting connectionSetting.name="Zongsoft.MsSql" driver="MsSql"
			                   value="Server=127.0.0.1;UserName=sa;Password=;Database=zongsoft;IntegratedSecurity=false;TrustServerCertificate=false;Timeout=30s" />

			<connectionSetting connectionSetting.name="Zongsoft.SQLite" driver="SQLite"
			                   value="Database=zongsoft.db;Mode=ReadWriteCreate;Cache=Default;ForeignKeys=true;Timeout=30s" />

			<connectionSetting connectionSetting.name="Zongsoft.DuckDB" driver="DuckDB"
			                   value="Database=zongsoft.duckdb" />

			<connectionSetting connectionSetting.name="Zongsoft.ClickHouse" driver="ClickHouse"
			                   value="Server=127.0.0.1;Port=8123;UserName=program;Password=xxxxxx;Database=zongsoft;Compression=True" />

			<connectionSetting connectionSetting.name="Zongsoft.TDengine" driver="TDengine"
			                   value="Server=127.0.0.1;Port=6030;UserName=program;Password=xxxxxx;Database=zongsoft;AutoReconnect=true;EnableCompression=true" />

			<connectionSetting connectionSetting.name="Zongsoft.Influx" driver="Influx"
			                   value="Server=http://127.0.0.1:8181;Database=zongsoft;Token=;Organization=;Precision=ms;Timeout=15s" />
		</connectionSettings>
	</option>

	<option path="/Externals/Redis">
		<connectionSettings default="Zongsoft">
			<connectionSetting connectionSetting.name="Zongsoft" driver="redis"
			                   value="server=127.0.0.1;username=;password=xxxxxx" />
		</connectionSettings>
	</option>

	<option path="/Externals/Amazon">
		<connectionSettings default="Zongsoft">
			<connectionSetting connectionSetting.name="Zongsoft" driver="amazon.s3"
			                   value="Server=http://127.0.0.1:9000;Region=;AccessKey=rustfsadmin;SecretKey=rustfsadmin;AccountId=;Client=zongsoft_development;Timeout=30s" />
		</connectionSettings>
	</option>

	<option path="/Externals/Etcd">
		<connectionSettings default="Zongsoft">
			<connectionSetting connectionSetting.name="Zongsoft" driver="Etcd"
			                   value="Server=127.0.0.1;Port=2379;UserName=;Password=" />
		</connectionSettings>
	</option>

	<option path="/Messaging">
		<connectionSettings>
			<connectionSetting connectionSetting.name="mqtt" driver="mqtt"
			                   value="server=127.0.0.1;username=program;password=xxxxxx;group=G1;client=zongsoft_development" />

			<connectionSetting connectionSetting.name="kafka" driver="Kafka"
			                   value="server=127.0.0.1:9092;username=;password=;group=G1;client=zongsoft_development;securityProtocol=Plaintext" />

			<connectionSetting connectionSetting.name="rabbitmq" driver="RabbitMQ"
			                   value="server=127.0.0.1;port=5672;username=guest;password=guest;container=/;group=G1;client=zongsoft_development" />

			<connectionSetting connectionSetting.name="zeromq" driver="ZeroMQ"
			                   value="server=127.0.0.1;port=7969;group=G1;client=zongsoft_development" />

			<connectionSetting connectionSetting.name="redis" driver="redis"
			                   value="server=127.0.0.1;username=;password=xxxxxx;group=G1;client=zongsoft_development;deadline=10000;idleTimeout=30s" />
		</connectionSettings>
	</option>
</configuration>
